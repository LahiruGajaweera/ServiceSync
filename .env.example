# ─────────────────────────────────────────────────────────
# ServiceSync Environment Variables
# ─────────────────────────────────────────────────────────
# HOW TO USE:
#   1. Copy this file:  cp .env.example .env
#   2. Fill in the values below
#   3. NEVER commit the .env file to Git
# ─────────────────────────────────────────────────────────

# PostgreSQL Database
DB_USER=servicesync_user
DB_PASSWORD=change_me_please_123
DB_NAME=servicesync_db

# JWT Secret Key — generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=generate_a_64_character_random_string_here

# Optional: SMS Gateway (Sprint 03)
# SMS_API_KEY=your_sms_api_key_here
# SMS_SENDER_ID=ServiceSync
